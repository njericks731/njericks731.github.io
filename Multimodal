    <!-- WEB AUDIO API & INTERACTIVE SCRIPT -->
    <script>
        // Web Audio Context & Oscillator Engine setup
        let audioCtx = null;
        let isPlaying = false;
        let currentTrack = 'human'; // 'human' or 'ai'

        // Audio Nodes
        let osc1, osc2, gainNodeMaster, gainHuman, gainAI, filterNode;
        let analyser;

        // Visualizer Setup
        const canvas = document.getElementById('waveform-canvas');
        const canvasCtx = canvas.getContext('2d');

        function initAudio() {
            if (audioCtx) return;

            const AudioContext = window.AudioContext || window.webkitAudioContext;
            audioCtx = new AudioContext();

            // Analyser for visualizer
            analyser = audioCtx.createAnalyser();
            analyser.fftSize = 64;

            // Master Filter
            filterNode = audioCtx.createBiquadFilter();
            filterNode.type = 'lowpass';
            filterNode.frequency.value = 1200;

            // Master Gain
            gainNodeMaster = audioCtx.createGain();
            gainNodeMaster.gain.value = 0.3;

            // Track Gains for Crossfading
            gainHuman = audioCtx.createGain();
            gainAI = audioCtx.createGain();
            
            // Initial Balance (100% Human, 0% AI)
            gainHuman.gain.value = 1.0;
            gainAI.gain.value = 0.0;

            // Connections
            filterNode.connect(analyser);
            analyser.connect(gainNodeMaster);
            gainNodeMaster.connect(audioCtx.destination);

            drawVisualizer();
        }

        // Start Audio Loop
        function startSynth() {
            if (!audioCtx) initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            // Create Oscillators (Warm Human Chord vs Machine Saw)
            osc1 = audioCtx.createOscillator();
            osc2 = audioCtx.createOscillator();

            // Human Synth: Smooth Triangle wave with subtle detune
            osc1.type = 'triangle';
            osc1.frequency.setValueAtTime(220, audioCtx.currentTime); // A3 note
            osc1.detune.setValueAtTime(4, audioCtx.currentTime); // Slight organic warmth

            // AI Synth: Sharp Sawtooth wave, rigid frequency
            osc2.type = 'sawtooth';
            osc2.frequency.setValueAtTime(220, audioCtx.currentTime); 
            osc2.detune.setValueAtTime(0, audioCtx.currentTime); // Exact 0 detune (quantized)

            // Connect Oscillators to respective gain branches
            osc1.connect(gainHuman);
            osc2.connect(gainAI);

            gainHuman.connect(filterNode);
            gainAI.connect(filterNode);

            osc1.start();
            osc2.start();
            isPlaying = true;

            document.getElementById('audio-status').innerText = 'STATUS: PLAYING LIVE AUDIO';
            document.getElementById('audio-status').classList.replace('text-slate-400', 'text-daw-human');
        }

        function stopSynth() {
            if (osc1) osc1.stop();
            if (osc2) osc2.stop();
            isPlaying = false;
            document.getElementById('audio-status').innerText = 'STATUS: ENGINE PAUSED';
            document.getElementById('audio-status').classList.replace('text-daw-human', 'text-slate-400');
        }

        // Play/Pause Button Listener
        const btnPlay = document.getElementById('btn-play-pause');
        btnPlay.addEventListener('click', () => {
            if (!isPlaying) {
                startSynth();
                btnPlay.classList.replace('bg-daw-human', 'bg-daw-accent');
                document.getElementById('play-btn-text').innerText = 'PAUSE AUDIO DEMO';
            } else {
                stopSynth();
                btnPlay.classList.replace('bg-daw-accent', 'bg-daw-human');
                document.getElementById('play-btn-text').innerText = 'START AUDIO DEMO';
            }
        });

        // Crossfader Input Control
        const crossfader = document.getElementById('crossfader');
        crossfader.addEventListener('input', (e) => {
            const val = e.target.value / 100; // 0 to 1
            if (gainHuman && gainAI) {
                gainHuman.gain.value = 1 - val;
                gainAI.gain.value = val;
            }

            // Update visual tags and highlight thumbs
            const visTag = document.getElementById('visualizer-mode-tag');
            if (val > 0.5) {
                visTag.innerText = `MODE: AI MIX (${Math.round(val * 100)}%)`;
                visTag.className = 'text-daw-ai font-mono text-xs';
                crossfader.classList.add('ai-thumb');
                showAnalysis('ai');
            } else {
                visTag.innerText = `MODE: HUMAN MIX (${Math.round((1 - val) * 100)}%)`;
                visTag.className = 'text-daw-human font-mono text-xs';
                crossfader.classList.remove('ai-thumb');
                showAnalysis('human');
            }
        });

        // A/B Selection Buttons
        document.getElementById('btn-select-human').addEventListener('click', () => {
            crossfader.value = 0;
            crossfader.dispatchEvent(new Event('input'));
            updateABButtons('human');
        });

        document.getElementById('btn-select-ai').addEventListener('click', () => {
            crossfader.value = 100;
            crossfader.dispatchEvent(new Event('input'));
            updateABButtons('ai');
        });

        function updateABButtons(type) {
            const btnH = document.getElementById('btn-select-human');
            const btnA = document.getElementById('btn-select-ai');
            if (type === 'human') {
                btnH.className = 'py-2 px-3 rounded border border-daw-human bg-daw-human/20 text-daw-human font-mono text-xs font-bold transition-all text-center';
                btnA.className = 'py-2 px-3 rounded border border-slate-700 bg-slate-800 text-slate-400 font-mono text-xs font-bold hover:border-daw-ai hover:text-daw-ai transition-all text-center';
            } else {
                btnA.className = 'py-2 px-3 rounded border border-daw-ai bg-daw-ai/20 text-daw-ai font-mono text-xs font-bold transition-all text-center';
                btnH.className = 'py-2 px-3 rounded border border-slate-700 bg-slate-800 text-slate-400 font-mono text-xs font-bold hover:border-daw-human hover:text-daw-human transition-all text-center';
            }
        }

        function showAnalysis(type) {
            if (type === 'human') {
                document.getElementById('analysis-human').classList.remove('hidden');
                document.getElementById('analysis-ai').classList.add('hidden');
                updateABButtons('human');
            } else {
                document.getElementById('analysis-ai').classList.remove('hidden');
                document.getElementById('analysis-human').classList.add('hidden');
                updateABButtons('ai');
            }
        }

        // Synth Filter Parameter Control
        document.getElementById('param-cutoff').addEventListener('input', (e) => {
            if (filterNode) {
                filterNode.frequency.value = e.target.value;
            }
        });

        // Real-time Spectrum Visualizer Animation
        function drawVisualizer() {
            requestAnimationFrame(drawVisualizer);
            if (!analyser) return;

            const bufferLength = analyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            analyser.getByteFrequencyData(dataArray);

            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;

            canvasCtx.clearRect(0, 0, canvas.width, canvas.height);

            const barWidth = (canvas.width / bufferLength) * 2.5;
            let barHeight;
            let x = 0;

            const isAi = crossfader.value > 50;
            const barColor = isAi ? '#A855F7' : '#06B6D4';

            for (let i = 0; i < bufferLength; i++) {
                barHeight = dataArray[i] / 2;
                canvasCtx.fillStyle = barColor;
                canvasCtx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);
                x += barWidth + 2;
            }
        }

        // Multimodal Mode Tabs Logic
        const tabs = document.querySelectorAll('.mode-tab');
        const contents = document.querySelectorAll('.mode-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const targetId = tab.getAttribute('data-target');

                // Reset Tab Styles
                tabs.forEach(t => {
                    t.className = 'mode-tab p-3 rounded-lg bg-slate-800/50 border border-slate-700 text-slate-400 font-mono text-xs font-bold text-left hover:border-slate-500 transition-all';
                });

                // Set Active Tab Style
                tab.className = 'mode-tab p-3 rounded-lg bg-daw-panel border border-daw-human text-daw-human font-mono text-xs font-bold text-left transition-all';

                // Hide All Content
                contents.forEach(c => c.classList.add('hidden'));

                // Show Selected Content
                document.getElementById(targetId).classList.remove('hidden');
            });
        });

        // Accessibility Accordion Toggle Logic
        document.querySelectorAll('.accordion-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const content = button.nextElementSibling;
                const icon = button.querySelector('span:last-child');
                content.classList.toggle('hidden');
                icon.innerText = content.classList.contains('hidden') ? '+' : '−';
            });
        });
    </script>
</body>
</html>
